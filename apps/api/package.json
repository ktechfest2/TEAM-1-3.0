{
  "name": "@trustelect/api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "admin:create": "nest build && node dist/cli/create-admin.js",
    "register:import": "nest build && node dist/cli/import-register.js",
    "register:fetch": "nest build && node dist/cli/fetch-register.js",
    "ai:eval": "nest build && node dist/cli/ai-eval.js",
    "assistant:eval": "nest build && VERIFICATION_WORKER=off CHAIN_ANCHOR_WORKER=off WHATSAPP_PROVIDER=log node dist/cli/assistant-eval.js",
    "chain:verify": "nest build && VERIFICATION_WORKER=off CHAIN_ANCHOR_WORKER=off node dist/cli/chain-verify.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/throttler": "^6.8.0",
    "@trustelect/shared": "0.1.0",
    "drizzle-orm": "^1.0.0-rc.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^1.0.0-rc.5",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
